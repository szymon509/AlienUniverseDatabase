<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:local="using:AlienUniverseDatabase"
        xmlns:models="using:AlienUniverseDatabase.models"
        xmlns:vm="using:AlienUniverseDatabase"

        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
        x:Class="AlienUniverseDatabase.MainWindow"
        
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        
        Title="Alien Universe Database"
        Width="1000" Height="550">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/> <ColumnDefinition Width="*"/>   <ColumnDefinition Width="250"/> </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="5">
            <DockPanel>
                <TextBlock Text="LISTA POSTACI" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox ItemsSource="{Binding Postacie}" 
                         SelectedItem="{Binding WybranaPostac}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Characters">
                            <TextBlock Text="{Binding ImieNazwisko}" Margin="5"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Margin="15,0" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
            <ScrollViewer>
                <StackPanel DataContext="{Binding WybranaPostac}" x:DataType="models:Characters">
                    
                    <TextBlock Text="KARTA POSTACI" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Imię i Nazwisko:" FontWeight="Bold"/>
                    <TextBox Text="{Binding ImieNazwisko}" IsReadOnly="True" Margin="0,0,0,5"/>

                    <TextBlock Text="Rola:" FontWeight="Bold"/>
                    <TextBox Text="{Binding Rola}" IsReadOnly="True" Margin="0,0,0,5"/>
                    
                    <TextBlock Text="Rasa:" FontWeight="Bold"/>
                    <TextBox Text="{Binding Rasa}" IsReadOnly="True" Margin="0,0,0,5"/>

                    <TextBlock Text="Opis:" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Charakterystyka}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Background="BlueViolet" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel>
                <TextBlock Text="DODAJ NOWĄ POSTAĆ" FontWeight="Bold" FontSize="16" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                <TextBlock Text="Imię i Nazwisko:" Margin="0,5,0,0"/>
                <TextBox Text="{Binding NoweImie}" Watermark="Np. Private Hudson"/>

                <TextBlock Text="Rola:" Margin="0,5,0,0"/>
                <TextBox Text="{Binding NowaRola}" Watermark="Np. Żołnierz"/>

                <TextBlock Text="Rasa:" Margin="0,5,0,0"/>
                <TextBox Text="{Binding NowaRasa}" Watermark="Np. Człowiek"/>

                <Button Command="{Binding DodajPostac}" 
                        Content="DODAJ DO BAZY" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"
                        FontWeight="Bold"
                        Background="#4CAF50" 
                        Foreground="White"
                        Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>